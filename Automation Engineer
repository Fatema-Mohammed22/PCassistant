#1. Google search
def googleSearch (query: str): #used string for user input
    """Searches Google for the given query."""
    try:
        if not query.strip():
            return "No Search Term Provide."
        webbrowser.open(f'https://www.google.search?q={query}') # opening google search with the query
        return(f'Searching Google for: {query}')
    except Exception as e:
        return f'Error in Google Search: {str(e)}'
    
#2. Youtube search
def yotubeSearch (query: str): #used string for user input
    """Searches YouTube for the given query."""
    try:
        if not query.strip():
            return "No Search Term Provide."
        webbrowser.open(f'https://www.youtube.com/result?search_query={query}') # opening youtube search with the query
        return(f'Searching Youtube for: {query}')
    except Exception as e:
        return f'Error Preforming Youtube Search: {str(e)}'
    
