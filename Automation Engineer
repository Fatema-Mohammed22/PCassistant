#5. Brightness control
def lowerbrightness():
    try:
        current_brightness = sbc.get_brightness()
        if current_brightness > 0: # Check if brightness is above 0
            sbc.set_brightness(current_brightness - 10)
            return f'Brightness decreased to {current_brightness - 10 , 0 }%' # Decrease brightness by 10%
        else:
            return 'Brightness is already at the minimum level.'
    except Exception as e:
        return f'Error adjusting brightness: {str(e)}'  
    
def higherbrightness():
    try:
        current_brightness =sbc.get_brightness( display = 0 ) [0] # Get current brightness
        sbc.set_brightness (min(current_brightness + 10 ,100))
        return f'Brightness increased to {current_brightness + 10 ,100 }%' # Increase brightness by 10%
    except Exception as e:
        return f'Error adjusting brightness: {str(e)}'

#6. Volume control using pycaw
def set_volume(level:float):
    try:
        devices = AudioUtilities.GetSpeakers()
        interface = devices.Activate(ISimpleAudioVolume.iid , CLSCTX_ALL, None )
        volume =interface.QueryInterface(ISimpleAudioVolume)
        volume.SetMasterVolume(level,None)
        return f'Volumeset to {int(level * 100)} %'
    except Exception as e:
        return f'The Volume could not be set: {str(e)}'
    
def setlowerVolume():
        return set_volume(0.2)

def sethigherVolume():
    return set_volume(0.9)

#7.Alternative Volume control using nircmd 
def set_volume__nircmd(level,int):
    try:
        os.system(f'nircmd.exe setsysvolume {int(level * 65535)}')
        return f'Volume set to {int(level * 100)}%'
    except Exception as e:
        return f'Error setting volume: {str(e)}'
